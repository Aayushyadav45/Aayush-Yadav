<footer class="text-center text-sm mu py-10">&copy; <span id="yr"></span> Aayush Kumar Yadav</footer>
<div id="toast" class="glass px-5 py-3 text-sm" role="status" aria-live="polite"></div>

<script>
const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)],root=document.documentElement;
$('#yr').textContent=new Date().getFullYear();
// typed role line
const roles=['SOC analyst in the making','threat hunting learner','data science enthusiast','full-stack developer'];
(function(){const el=$('#typed');let r=0,i=0,del=false;
  if(matchMedia('(prefers-reduced-motion:reduce)').matches){el.textContent=roles[0];return}
  (function tick(){const w=roles[r];el.textContent=w.slice(0,i);
    if(!del&&i===w.length){del=true;return setTimeout(tick,1500)}
    if(del&&i===0){del=false;r=(r+1)%roles.length}
    i+=del?-1:1;setTimeout(tick,del?35:70)})()})();
// scroll progress
addEventListener('scroll',()=>{const h=document.documentElement;$('#bar').style.width=(h.scrollTop/(h.scrollHeight-h.clientHeight)*100)+'%'},{passive:true});
// copy email
$('#copy').onclick=async()=>{try{await navigator.clipboard.writeText('aayushyadav2051@gmail.com');show('Email copied.')}catch(e){show('Copy failed. Email: aayushyadav2051@gmail.com')}};
// persisted prefs (storage may be unavailable)
const ls={get:k=>{try{return localStorage.getItem(k)}catch(e){return null}},set:(k,v)=>{try{localStorage.setItem(k,v)}catch(e){}}};
if(ls.get('theme'))root.dataset.theme=ls.get('theme');
if(ls.get('accent'))root.dataset.accent=ls.get('accent');
$('#theme').onclick=()=>{const t=root.dataset.theme==='dark'?'light':'dark';root.dataset.theme=t;ls.set('theme',t)};
const ac=['violet','cyan','lime'];
$('#accent').onclick=()=>{const a=ac[(ac.indexOf(root.dataset.accent)+1)%ac.length];root.dataset.accent=a;ls.set('accent',a)};
// mobile menu
const menu=$('#menu'),bg=$('#burger');
bg.onclick=()=>{const o=menu.classList.toggle('hidden');menu.classList.toggle('flex',!o);bg.setAttribute('aria-expanded',String(!o))};
$$('#menu a').forEach(a=>a.onclick=()=>{menu.classList.add('hidden');menu.classList.remove('flex');bg.setAttribute('aria-expanded','false')});
// scroll-spy
const links=$$('.nav a'),secs=$$('main section');
const spy=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting)links.forEach(l=>l.classList.toggle('active',l.getAttribute('href')==='#'+e.target.id))}),{rootMargin:'-45% 0px -50% 0px'});
secs.forEach(s=>spy.observe(s));
// certificates: add an `img` (image path or data URI) to make a card open its certificate when clicked
const CERTS=[
  {t:'Exploring Networking with Cisco Packet Tracer',m:'Cisco Networking Academy, 13 Oct 2026',d:'Completed the Cisco Networking Academy course on building and exploring networks in Cisco Packet Tracer.',img:'data:image/jpeg;base64,'},
  {t:'AI & Machine Learning Vocational Training',m:'Aimaxa Tech, 01 to 28 Jul 2026',d:'One month of vocational training in Artificial Intelligence and Machine Learning, with the assigned project completed on time.',l:'https://aimaxa.com/certification/2026/07/cert-2026-4097.pdf',img:'data:image/jpeg;base64,'},
  {t:'Learn Java',m:'IBM SkillsBuild, 09 Oct 2025, 25 learning hours',d:'Completion certificate for the IBM SkillsBuild Learn Java course.',img:'data:image/jpeg;base64,'},
  {t:'ReactNext Workshop',d:'Hands-on workshop covering modern front-end development with React and Next.js.',img:''},
  {t:'Flutter Workshop',d:'Practical training in building cross-platform applications using Flutter and Dart.',img:''},
  {t:'Campus to Corporate',d:'Career-readiness program focused on industry expectations and professional skills.',img:''}
];
function drawCerts(){$('#certs').innerHTML=CERTS.map((c,i)=>`<article class='glass p-5 flex flex-col ${c.img?'cert-click':''}' ${c.img?`data-i='${i}' role='button' tabindex='0' aria-label='Open ${c.t} certificate'`:''}><h3 class='font-semibold'>${c.t}</h3>${c.m?`<div class='text-xs mt-1' style='color:var(--a)'>${c.m}</div>`:''}<p class='text-sm mu mt-2 flex-1'>${c.d}</p><div class='flex gap-4 mt-4 text-sm'>${c.img?`<span class='font-semibold' style='color:var(--a)'>View certificate</span>`:''}${c.l?`<a class='hover:text-[var(--a)]' href='${c.l}' target='_blank' rel='noopener'>Verify online</a>`:''}</div></article>`).join('')}
drawCerts();
const lb=$('#lb');
function openCert(el){const c=CERTS[+el.dataset.i];$('#lbimg').src=c.img;$('#lbimg').alt=c.t+' certificate';lb.classList.add('open')}
$('#certs').addEventListener('click',e=>{if(e.target.closest('a'))return;const el=e.target.closest('.cert-click');if(el)openCert(el)});
$('#certs').addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){const el=e.target.closest('.cert-click');if(el){e.preventDefault();openCert(el)}}});
lb.onclick=()=>lb.classList.remove('open');
addEventListener('keydown',e=>{if(e.key==='Escape')lb.classList.remove('open')});
// project filter
$$('.filter').forEach(b=>b.onclick=()=>{
  $$('.filter').forEach(x=>x.classList.toggle('on',x===b));
  $$('.proj').forEach(p=>p.classList.toggle('hide',b.dataset.f!=='all'&&!p.dataset.c.split(' ').includes(b.dataset.f)));
});
// toast + contact mock
const toast=$('#toast');let tt;
function show(msg){toast.textContent=msg;toast.classList.add('show');clearTimeout(tt);tt=setTimeout(()=>toast.classList.remove('show'),3200)}
// Optional: paste a Formspree (or similar) endpoint here when you host the site so messages are delivered directly
const FORM_ENDPOINT='';
$('#send').onclick=async()=>{
  const n=$('#n').value.trim(),e=$('#e').value.trim(),m=$('#m').value.trim();
  if(!n||!/^\S+@\S+\.\S+$/.test(e)||!m){show('Add your name, a valid email and a message.');return}
  const to='aayushyadav2051@gmail.com',sub='Portfolio message from '+n,txt=m+'\n\nFrom: '+n+' ('+e+')',btn=$('#send');
  if(FORM_ENDPOINT){
    btn.disabled=true;
    try{const r=await fetch(FORM_ENDPOINT,{method:'POST',headers:{'Content-Type':'application/json',Accept:'application/json'},body:JSON.stringify({name:n,email:e,message:m})});
      if(r.ok){btn.disabled=false;show('Message sent. Thanks, '+n.split(' ')[0]+'!');['#n','#e','#m'].forEach(s=>$(s).value='');return}}catch(x){}
    btn.disabled=false;show('Could not send directly. Use one of the options below.');
  }else show('Your message is ready. Choose how to send it below.');
  $('#mailto').href='mailto:'+to+'?subject='+encodeURIComponent(sub)+'&body='+encodeURIComponent(txt);
  $('#gmail').href='https://mail.google.com/mail/?view=cm&fs=1&to='+to+'&su='+encodeURIComponent(sub)+'&body='+encodeURIComponent(txt);
  $('#copymsg').onclick=async()=>{try{await navigator.clipboard.writeText(txt);show('Message copied.')}catch(x){show('Copy failed. Email '+to)}};
  $('#sendopts').classList.remove('hidden');
};
</script>
</body>
</html>
