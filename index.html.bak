</section>
<div id="lb" class="hidden fixed inset-0 z-[80] items-center justify-center p-4" style="background:rgba(0,0,0,.85)" role="dialog" aria-label="Certificate preview"><img id="lbimg" alt="" class="max-h-full max-w-full rounded-xl"></div>

<section id="contact" class="py-20">
  <h2 class="text-3xl sm:text-4xl font-bold mb-8">Contact</h2>
  <div class="grid md:grid-cols-2 gap-5">
